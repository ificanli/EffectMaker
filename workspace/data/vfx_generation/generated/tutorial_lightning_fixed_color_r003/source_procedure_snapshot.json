      "parameter_ranges": [],
      "required_shader_features": ["opacity_control", "color_control"],
      "required_texture_tags": ["semantic.lightning"],
      "evidence_status": "tutorial_fact",
      "evidence_refs": ["part03.zh.srt:00:13:31-00:13:43"]
