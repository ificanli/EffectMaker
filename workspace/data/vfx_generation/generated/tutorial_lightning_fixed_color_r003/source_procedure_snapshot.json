      ],
      "required_shader_features": ["opacity_control", "color_control"],
      "required_texture_tags": ["semantic.lightning", "role.core_shape"],
      "evidence_status": "tutorial_fact",
      "evidence_refs": ["part03.zh.srt:00:00:02-00:00:50", "part03.zh.srt:00:02:30-00:02:50"]
    },
    {
      "step_id": "step_002",
      "order": 2,
      "action": "bind_texture",
      "authoring_stage": "texture_authoring",
      "target_role": "core",
      "target_layer": "LightningShapeTexture",
      "instruction": "在 Photoshop 参考分析与贴图制作中保留光柱感、锐边和非均匀形体；该片段不是 Unity 创建发光层或设置 Emission 的证据。",
      "parameter_ranges": [],
      "required_shader_features": [],
      "required_texture_tags": ["semantic.lightning", "luma.bright_core"],
      "evidence_status": "tutorial_fact",
      "evidence_refs": ["part03.zh.srt:00:05:33-00:05:53", "evidence/contact_sheet.jpg"]
    },
    {
