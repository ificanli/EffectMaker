    {
      "step_id": "step_001",
      "order": 1,
      "action": "bind_texture",
      "target_role": "core",
      "target_layer": "MainBolt",
      "instruction": "准备简单闪电形状贴图；闪电没有唯一固定形态，但轮廓必须具有硬朗、折线化和非均匀特征。",
      "parameter_ranges": [
        {"name": "source_texture_width", "unit": "pixels", "minimum": 1024, "maximum": 1024, "value": 1024},
