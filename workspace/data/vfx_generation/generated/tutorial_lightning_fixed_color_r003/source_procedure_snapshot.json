      "order": 3,
      "action": "bind_texture",
      "authoring_stage": "texture_authoring",
      "target_role": "core",
      "target_layer": "LightningShapeTexture",
      "instruction": "Photoshop 中复制图层、Ctrl+I 像素反相、最小值滤镜加粗，再用 Ctrl+T 自由变换形成粗细变化；不能据此要求复制 Unity 粒子对象。",
      "parameter_ranges": [],
      "required_shader_features": [],
      "required_texture_tags": ["semantic.lightning"],
      "evidence_status": "tutorial_fact",
      "evidence_refs": ["part03.zh.srt:00:05:54-00:06:37"]
    },
