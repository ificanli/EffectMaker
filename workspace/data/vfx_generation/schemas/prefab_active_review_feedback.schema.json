{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab_active_review_feedback.schema.json",
  "title": "Prefab Active Review Feedback",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "batch_id", "sample_id", "prefab_path", "action", "notes", "reviewed_at", "reviewer", "confirmation_mode", "ai_draft", "correction", "evidence", "result"],
  "properties": {
    "schema_version": { "const": "vfx_prefab_active_review_feedback.v1" },
    "record_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "sample_id": { "type": "string", "minLength": 1 },
    "prefab_path": { "type": "string", "minLength": 1 },
    "action": { "enum": ["AI判断正确", "应该更好", "应该更差", "特效元素错误", "特效类型错误", "风格判断错误", "主体不清楚", "层次有问题", "节奏有问题", "材质有问题", "无法播放", "无法判断"] },
    "selected_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["AI判断正确", "应该更好", "应该更差", "特效元素错误", "特效类型错误", "风格判断错误", "主体不清楚", "层次有问题", "节奏有问题", "材质有问题", "无法播放", "无法判断"] }
    },
    "review_scope": { "enum": ["aesthetic_correction", "semantic_function_only"] },
    "semantic_selection": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["semantic_schema_version", "ai_effect_elements", "selected_effect_elements", "selected_effect_elements_cn", "ai_effect_type", "selected_effect_type", "selected_effect_type_cn"],
      "properties": {
        "semantic_schema_version": { "type": "string", "minLength": 1 },
        "ai_effect_elements": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "selected_effect_elements": { "type": ["array", "null"], "items": { "type": "string" }, "uniqueItems": true },
        "selected_effect_elements_cn": { "type": ["array", "null"], "items": { "type": "string" } },
        "ai_effect_type": { "type": "string", "minLength": 1 },
        "selected_effect_type": { "type": ["string", "null"] },
        "selected_effect_type_cn": { "type": ["string", "null"] }
      }
    },
    "notes": { "type": "string", "maxLength": 2000 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "reviewer": { "const": "local_human" },
    "confirmation_mode": { "enum": ["human_accepted_ai_draft", "human_corrected_ai_draft", "human_exclusion"] },
    "ai_draft": { "type": "object" },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "label_delta"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "label_delta": { "type": "object" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_manifest_path", "capture_pipeline_version", "dynamic_frame_paths", "webgl_catalog_id"],
      "properties": {
        "capture_manifest_path": { "type": "string", "minLength": 1 },
        "capture_pipeline_version": { "const": "play_mode_runtime_isolated_multiview.v2" },
        "dynamic_frame_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "webgl_catalog_id": { "type": ["string", "null"] }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "trainable", "labels", "eligible_tasks", "exclusion_reason"],
      "properties": {
        "disposition": { "enum": ["human_gold", "excluded"] },
        "trainable": { "type": "boolean" },
        "labels": { "type": "object" },
        "eligible_tasks": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "exclusion_reason": { "type": ["string", "null"] }
      }
    }
  }
}
