{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "material_plan_validation_record.schema.json",
  "title": "MaterialPlan Unity Validation Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validation_id", "candidate_id", "effect_family", "plan_path", "graph_path", "prefab_path", "selected_pairs", "compile", "capture", "technical_label", "training", "aesthetic_label_source"],
  "properties": {
    "schema_version": { "const": "vfx_material_plan_validation_record.v1" },
    "validation_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "effect_family": { "type": "string", "minLength": 1 },
    "plan_path": { "type": "string", "minLength": 1 },
    "graph_path": { "type": "string", "minLength": 1 },
    "prefab_path": { "type": ["string", "null"] },
    "selected_pairs": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "compile": { "type": "object" },
    "capture": { "type": "object" },
    "technical_label": { "enum": ["visible", "near_blank", "compile_failed", "capture_failed"] },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_tasks", "excluded_tasks", "weight"],
      "properties": {
        "eligible_tasks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "excluded_tasks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "aesthetic_label_source": { "const": "none" }
  }
}
