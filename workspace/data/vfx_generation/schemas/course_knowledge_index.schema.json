{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "course_knowledge_index.schema.json",
  "title": "Course Knowledge Index Manifest",
  "type": "object",
  "required": ["schema_version", "created_at", "index_id", "input_count", "record_count", "record_type_counts", "status_counts", "files", "policy", "status"],
  "properties": {
    "schema_version": { "const": "course_knowledge_index.v1" },
    "created_at": { "type": "string", "minLength": 1 },
    "index_id": { "type": "string", "minLength": 1 },
    "input_count": { "type": "integer", "minimum": 0 },
    "record_count": { "type": "integer", "minimum": 0 },
    "record_type_counts": { "$ref": "#/$defs/countMap" },
    "status_counts": { "$ref": "#/$defs/countMap" },
    "files": { "type": "object" },
    "policy": { "type": "object" },
    "status": { "const": "pass" }
  },
  "$defs": {
    "countMap": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
  },
  "additionalProperties": false
}
