{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab_graph_constrained_decode.schema.json",
  "title": "Constrained PrefabGraph Decode",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "model_version", "checkpoint_path", "profiles", "candidate_count", "candidates", "status"],
  "properties": {
    "schema_version": { "const": "vfx_prefab_graph_constrained_decode.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "model_version": { "type": "string", "minLength": 1 },
    "checkpoint_path": { "type": "string", "minLength": 1 },
    "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["root_only", "particle_v1", "multi_particle"] } },
    "candidate_count": { "type": "integer", "minimum": 1 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "profile", "score", "tokens", "graph", "grammar", "training_scope"],
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^pfg_[0-9a-f]{20}$" },
          "profile": { "enum": ["root_only", "particle_v1", "multi_particle"] },
          "score": { "type": "number" },
          "tokens": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "graph": { "type": "object" },
          "grammar": {
            "type": "object",
            "additionalProperties": false,
            "required": ["valid", "masked_invalid_token_count", "selection_mode", "mask_events"],
            "properties": {
              "valid": { "const": true },
              "masked_invalid_token_count": { "type": "integer", "minimum": 1 },
              "selection_mode": { "const": "neural_ranked_valid_templates" },
              "mask_events": { "type": "array", "minItems": 1, "items": { "type": "object" } }
            }
          },
          "training_scope": { "const": "structure_only; no aesthetic or human preference supervision" }
        }
      }
    },
    "status": { "const": "pass" }
  }
}
