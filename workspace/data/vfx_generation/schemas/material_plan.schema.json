{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "material_plan.schema.json",
  "title": "Prompt Conditioned VFX Material Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "plan_id", "graph_id", "registry_id", "condition", "layers", "selection_policy", "quality_gates", "status"],
  "properties": {
    "schema_version": { "const": "vfx_material_plan.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "plan_id": { "type": "string", "minLength": 1 },
    "graph_id": { "type": "string", "pattern": "^pfg_[0-9a-f]{20}$" },
    "registry_id": { "type": "string", "minLength": 1 },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "effect_family", "style_family", "color_keywords", "performance_tier", "seed"],
      "properties": {
        "prompt": { "type": "string" },
        "effect_family": { "type": "string", "minLength": 1 },
        "style_family": { "type": "string", "minLength": 1 },
        "color_keywords": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "performance_tier": { "enum": ["standard", "mobile"] },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "node_id", "layer_role", "selected_candidate_id", "candidates", "status", "blocking_reasons"],
        "properties": {
          "component_id": { "type": "string", "minLength": 1 },
          "node_id": { "type": "string", "minLength": 1 },
          "layer_role": { "enum": ["core", "support", "hit", "residual"] },
          "selected_candidate_id": { "type": ["string", "null"] },
          "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
          "status": { "enum": ["pass", "blocked"] },
          "blocking_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shader_texture_joint_ranking", "prompt_conditioned", "project_bindable_only", "no_silent_fallback", "alternatives_per_layer"],
      "properties": {
        "shader_texture_joint_ranking": { "const": true },
        "prompt_conditioned": { "const": true },
        "project_bindable_only": { "const": true },
        "no_silent_fallback": { "const": true },
        "alternatives_per_layer": { "type": "integer", "minimum": 1 },
        "neural_asset_pair_ranking": { "type": "boolean" }
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duplicate_candidate_ids", "reference_shaders_selected", "nonproject_textures_selected", "blocked_materials_selected", "selected_layer_count", "layer_count"],
      "properties": {
        "duplicate_candidate_ids": { "const": 0 },
        "reference_shaders_selected": { "const": 0 },
        "nonproject_textures_selected": { "const": 0 },
        "blocked_materials_selected": { "const": 0 },
        "selected_layer_count": { "type": "integer", "minimum": 0 },
        "layer_count": { "type": "integer", "minimum": 1 }
      }
    },
    "status": { "enum": ["pass", "blocked"] }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "material", "shader", "texture", "texture_property_name", "scores", "selection_basis", "status"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["material_id", "path", "binding_status"],
          "properties": {
            "material_id": { "type": "string" },
            "path": { "type": "string", "pattern": "^Assets/" },
            "binding_status": { "const": "usable" }
          }
        },
        "shader": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset_id", "name", "path", "binding_status", "pipeline_tags"],
          "properties": {
            "asset_id": { "type": "string" },
            "name": { "type": ["string", "null"] },
            "path": { "type": "string", "pattern": "^Assets/" },
            "binding_status": { "const": "project_bindable" },
            "pipeline_tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        "texture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset_id", "path", "binding_status", "tags"],
          "properties": {
            "asset_id": { "type": "string" },
            "path": { "type": "string", "pattern": "^Assets/" },
            "binding_status": { "const": "project_bindable" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        "texture_property_name": { "type": "string", "pattern": "^_" },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "role", "slot", "style", "color", "pipeline", "performance", "pairing", "diversity", "total"],
          "properties": {
            "family": { "type": "number" }, "role": { "type": "number" }, "slot": { "type": "number" },
            "style": { "type": "number" }, "color": { "type": "number" }, "pipeline": { "type": "number" },
            "performance": { "type": "number" }, "pairing": { "type": "number" }, "diversity": { "type": "number" }, "total": { "type": "number" },
            "neural_probability": { "type": "number", "minimum": 0, "maximum": 1 }, "rank_total": { "type": "number" }
          }
        },
        "selection_basis": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "status": { "const": "pass" }
      }
    }
  }
}
