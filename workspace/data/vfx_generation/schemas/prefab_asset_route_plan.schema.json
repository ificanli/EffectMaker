{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab_asset_route_plan.schema.json",
  "title": "Prefab Asset Route Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "plan_id", "graph_id", "condition", "routes", "selection_policy", "status"],
  "properties": {
    "schema_version": { "const": "vfx_prefab_asset_route_plan.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "plan_id": { "type": "string", "minLength": 1 },
    "graph_id": { "type": "string", "pattern": "^pfg_[0-9a-f]{20}$" },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "effect_family", "style_family", "seed"],
      "properties": {
        "prompt": { "type": ["string", "null"] },
        "effect_family": { "type": ["string", "null"] },
        "style_family": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "route_kind", "target_component_id", "material", "texture", "mesh", "compatibility", "selection_basis", "status"],
        "properties": {
          "route_id": { "type": "string", "minLength": 1 },
          "route_kind": { "enum": ["billboard", "mesh_particle", "impact_decal"] },
          "target_component_id": { "type": ["string", "null"] },
          "material": { "$ref": "#/$defs/asset" },
          "texture": { "$ref": "#/$defs/asset" },
          "mesh": { "$ref": "#/$defs/asset" },
          "compatibility": { "type": "object" },
          "selection_basis": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "status": { "enum": ["pass", "needs_unity_validation", "blocked"] }
        }
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_selection", "texture_selection", "mesh_selection", "no_silent_fallback"],
      "properties": {
        "material_selection": { "const": "shader_property_and_texture_slot_compatibility" },
        "texture_selection": { "const": "content_tag_and_slot_role" },
        "mesh_selection": { "const": "unity_api_geometry_audit" },
        "no_silent_fallback": { "const": true }
      }
    },
    "status": { "enum": ["pass", "needs_unity_validation", "blocked"] }
  },
  "$defs": {
    "asset": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["asset_id", "path", "asset_type", "authorization_status", "selection_basis"],
      "properties": {
        "asset_id": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "asset_type": { "enum": ["material", "texture", "mesh"] },
        "authorization_status": { "enum": ["confirmed", "local_source_unconfirmed", "local_reference_only", "generated", "unknown"] },
        "selection_basis": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "sha256": { "type": ["string", "null"] },
        "shader_name": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "slot_roles": { "type": "array", "items": { "type": "string" } },
        "verification": { "type": ["string", "null"] }
      }
    }
  }
}
