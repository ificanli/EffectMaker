{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab_active_learning_batch.schema.json",
  "title": "Prefab Active Learning Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "batch_id", "dataset_id", "eligible_count", "review_budget", "review_rate", "selection_mix", "items", "quality_gates", "status"],
  "properties": {
    "schema_version": { "const": "vfx_prefab_active_learning_batch.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "batch_id": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "eligible_count": { "type": "integer", "minimum": 0 },
    "review_budget": { "type": "integer", "minimum": 0 },
    "review_rate": { "type": "number", "minimum": 0.01, "maximum": 0.1 },
    "selection_mix": { "type": "object" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["queue_index", "sample_id", "prefab_path", "cluster_id", "selection_reason", "priority_score", "signals", "ai_draft", "capture_manifest_path", "allowed_actions"],
        "properties": {
          "queue_index": { "type": "integer", "minimum": 1 },
          "sample_id": { "type": "string", "minLength": 1 },
          "prefab_path": { "type": ["string", "null"] },
          "cluster_id": { "type": "string", "minLength": 1 },
          "selection_reason": { "enum": ["uncertainty", "new_cluster", "model_disagreement", "promotion_top", "predicted_low", "random_audit", "combined_fill"] },
          "priority_score": { "type": "number" },
          "signals": { "type": "object" },
          "ai_draft": { "type": "object" },
          "capture_manifest_path": { "type": "string", "minLength": 1 },
          "allowed_actions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duplicate_queue_samples", "duplicate_queue_prefabs", "cluster_split_leakage", "non_visual_items", "already_gold_items", "regression_items"],
      "properties": {
        "duplicate_queue_samples": { "const": 0 },
        "duplicate_queue_prefabs": { "const": 0 },
        "cluster_split_leakage": { "const": 0 },
        "non_visual_items": { "const": 0 },
        "already_gold_items": { "const": 0 },
        "regression_items": { "const": 0 }
      }
    },
    "status": { "const": "pass" }
  }
}
