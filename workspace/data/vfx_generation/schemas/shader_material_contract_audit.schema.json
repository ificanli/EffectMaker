{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shader_material_contract_audit.schema.json",
  "title": "Shader Material Texture Contract Audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "graph_id", "effect_family", "registry_id", "layers", "quality_gates", "training_eligibility", "status"],
  "properties": {
    "schema_version": { "const": "shader_material_contract_audit.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "graph_id": { "type": "string", "pattern": "^pfg_[0-9a-f]{20}$" },
    "effect_family": { "type": "string", "minLength": 1 },
    "registry_id": { "type": "string", "minLength": 1 },
    "evidence_scope": { "const": "static_heuristic_only" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "layer_role", "renderer_mode", "material_path", "shader_name", "texture_path", "shader_features", "required_features", "texture_tags", "blocking_reasons", "status"],
        "properties": {
          "component_id": { "type": "string" },
          "layer_role": { "enum": ["core", "support", "hit", "residual"] },
          "renderer_mode": { "type": "string" },
          "material_path": { "type": ["string", "null"] },
          "shader_name": { "type": ["string", "null"] },
          "texture_path": { "type": ["string", "null"] },
          "shader_features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "required_features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "texture_tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "blocking_reasons": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "status": { "enum": ["pass", "blocked"] }
        }
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_count", "blocked_layer_count", "missing_asset_count", "shader_role_mismatch_count", "texture_role_mismatch_count", "single_template_all_roles", "vertex_stream_contract_missing_count"],
      "properties": {
        "layer_count": { "type": "integer", "minimum": 1 },
        "blocked_layer_count": { "type": "integer", "minimum": 0 },
        "missing_asset_count": { "type": "integer", "minimum": 0 },
        "shader_role_mismatch_count": { "type": "integer", "minimum": 0 },
        "texture_role_mismatch_count": { "type": "integer", "minimum": 0 },
        "single_template_all_roles": { "type": "boolean" },
        "vertex_stream_contract_missing_count": { "type": "integer", "minimum": 0 }
      }
    },
    "training_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_generation_supervision", "proposal_failure_supervision", "reason"],
      "properties": {
        "positive_generation_supervision": { "type": "boolean" },
        "proposal_failure_supervision": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "status": { "enum": ["pass", "blocked"] }
  }
}
