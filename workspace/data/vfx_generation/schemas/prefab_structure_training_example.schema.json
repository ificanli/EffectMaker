{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab_structure_training_example.schema.json",
  "title": "Prefab Structure TrainingExample",
  "type": "object",
  "required": ["schema_version", "example_id", "run_id", "candidate_id", "inputs", "outputs", "label", "task_membership", "split_group", "provenance"],
  "properties": {
    "schema_version": { "const": "training_example.v1" },
    "example_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "object",
      "required": ["prompt", "negative_prompt", "target_style_profile", "prefab_path", "source_category", "effect_family_hint", "dependency_health", "material_selection"],
      "properties": {
        "prompt": { "type": "string" },
        "negative_prompt": { "type": "string" },
        "target_style_profile": { "type": "object" },
        "prefab_path": { "type": "string", "pattern": "^Assets/.+\\.prefab$" },
        "source_category": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "effect_family_hint": { "type": "string" },
        "dependency_health": { "type": "object" },
        "material_selection": { "type": "object" }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": ["render_paths", "features_path", "observed_style_profile", "prefab_summary", "prefab_graph", "particle_systems", "renderers", "animations"],
      "properties": {
        "render_paths": { "type": "array", "items": { "type": "string" } },
        "diagnostic_render_paths": { "type": "array", "items": { "type": "string" } },
        "material_timeline_path": { "type": ["string", "null"] },
        "contact_sheet_path": { "type": ["string", "null"] },
        "render_evidence": { "type": ["object", "null"] },
        "features_path": { "type": "null" },
        "observed_style_profile": { "type": "object" },
        "prefab_summary": {
          "type": "object",
          "required": ["status", "node_count", "particle_system_count", "renderer_count", "estimated_duration_seconds", "looping", "missing_script_count", "missing_material_slot_count"],
          "properties": {
            "status": { "enum": ["particle_playable", "particle_context_required", "static_or_contextual", "empty_or_invalid", "audit_error"] },
            "node_count": { "type": "integer", "minimum": 0 },
            "particle_system_count": { "type": "integer", "minimum": 0 },
            "renderer_count": { "type": "integer", "minimum": 0 },
            "estimated_duration_seconds": { "type": "number", "minimum": 0 },
            "looping": { "type": "boolean" },
            "missing_script_count": { "type": "integer", "minimum": 0 },
            "missing_material_slot_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "prefab_graph": { "type": "array", "minItems": 1 },
        "particle_systems": { "type": "array" },
        "renderers": { "type": "array" },
        "animations": { "type": "array" }
      },
      "additionalProperties": true
    },
    "label": {
      "type": "object",
      "required": ["decision", "technical_status", "aesthetic_quality", "style_match_decision", "rank"],
      "properties": {
        "decision": { "const": "structure_observation_unlabeled_aesthetic" },
        "technical_status": { "enum": ["particle_playable", "particle_context_required", "static_or_contextual", "empty_or_invalid", "audit_error"] },
        "aesthetic_quality": { "const": "unlabeled" },
        "style_match_decision": { "const": "unlabeled" },
        "rank": { "type": "null" }
      },
      "additionalProperties": true
    },
    "task_membership": {
      "type": "object",
      "required": ["prefab_structure", "particle_parameters", "play_mode_render_candidate", "image_conditioned", "aesthetic_preference"],
      "properties": {
        "prefab_structure": { "const": true },
        "particle_parameters": { "type": "boolean" },
        "play_mode_render_candidate": { "type": "boolean" },
        "image_conditioned": { "type": "boolean" },
        "aesthetic_preference": { "const": false }
      },
      "additionalProperties": false
    },
    "split_group": {
      "type": "object",
      "required": ["prefab_group", "source_group"],
      "properties": {
        "prefab_group": { "type": "string", "minLength": 1 },
        "source_group": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["case_path", "audit_path", "generator"],
      "properties": {
        "case_path": { "type": "string", "minLength": 1 },
        "audit_path": { "type": "string", "minLength": 1 },
        "generator": { "const": "prefab_structure_dataset.v1" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
