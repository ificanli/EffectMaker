{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab_training_case.schema.json",
  "title": "VFXPrefabTrainingCase",
  "type": "object",
  "required": ["schema_version", "case_id", "source", "inputs", "observations", "training"],
  "properties": {
    "schema_version": { "type": "string", "const": "vfx_prefab_training_case.v1" },
    "case_id": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["source_id", "prefab_path", "source_category"],
      "properties": {
        "source_id": { "type": "string" },
        "prefab_path": { "type": "string" },
        "source_category": { "type": "array", "items": { "type": "string" } },
        "effect_family_hint": { "type": "string" }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object",
      "required": ["prompt", "target_style_profile", "material_selection"],
      "properties": {
        "prompt": { "type": "string" },
        "negative_prompt": { "type": "string" },
        "target_style_profile": { "$ref": "style_profile.schema.json" },
        "material_selection": { "type": "object" }
      },
      "additionalProperties": true
    },
    "observations": {
      "type": "object",
      "required": ["observed_style_profile", "dependency_health", "runtime_observation"],
      "properties": {
        "observed_style_profile": { "$ref": "style_profile.schema.json" },
        "dependency_health": { "type": "object" },
        "runtime_observation": { "type": "object" }
      },
      "additionalProperties": true
    },
    "training": {
      "type": "object",
      "required": ["supervision_status", "eligible_for", "excluded_from", "blocking_reasons"],
      "properties": {
        "supervision_status": { "type": "string" },
        "eligible_for": { "type": "array", "items": { "type": "string" } },
        "excluded_from": { "type": "array", "items": { "type": "string" } },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
