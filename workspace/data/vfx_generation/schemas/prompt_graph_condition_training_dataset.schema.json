{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt_graph_condition_training_dataset.schema.json",
  "title": "Prompt Graph Condition Training Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "dataset_id", "example_count", "split_counts", "effect_families", "supervision", "files", "status"],
  "properties": {
    "schema_version": { "const": "vfx_prompt_graph_condition_training_dataset.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "example_count": { "type": "integer", "minimum": 1 },
    "split_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "effect_families": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "supervision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label_source", "human_labels_used", "aesthetic_labels_used", "status"],
      "properties": {
        "label_source": { "const": "ai_hypothesis" },
        "human_labels_used": { "const": 0 },
        "aesthetic_labels_used": { "const": 0 },
        "status": { "const": "hypothesis_only" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["examples"],
      "properties": { "examples": { "type": "string", "minLength": 1 } }
    },
    "status": { "const": "pass" }
  }
}
