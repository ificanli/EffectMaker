{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vfxspec.schema.json",
  "title": "VFXSpec",
  "type": "object",
  "required": [
    "schema_version",
    "effect_family",
    "effect_type",
    "prompt",
    "negative_prompt",
    "generation",
    "layers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "vfxspec.v1"
    },
    "effect_type": {
      "type": "string",
      "examples": ["slash"]
    },
    "effect_family": {
      "type": "string",
      "examples": ["slash", "fire", "lightning", "shield", "smoke", "explosion", "magic_circle", "water"]
    },
    "adapter": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "examples": ["slash.adapter", "fire.adapter", "lightning.adapter", "shield.adapter", "magic_circle.adapter"]
        },
        "version": { "type": "string" },
        "schema_ref": {
          "type": "string",
          "examples": ["schemas/adapters/slash_adapter.schema.json"]
        },
        "generator_family": { "type": "string" },
        "specialized_metrics": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "description": "Family-specific topology and shape controls. Validate this object with the matching schema under schemas/adapters/.",
      "additionalProperties": true
    },
    "prompt": {
      "type": "string"
    },
    "negative_prompt": {
      "type": "string"
    },
    "target_style_profile": {
      "$ref": "style_profile.schema.json"
    },
    "observed_style_profile": {
      "$ref": "style_profile.schema.json"
    },
    "reference": {
      "type": "object",
      "properties": {
        "source_id": { "type": "string" },
        "case_id": { "type": "string" },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["time_seconds", "path"],
            "properties": {
              "time_seconds": { "type": "number" },
              "path": { "type": "string" },
              "role": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "generation": {
      "type": "object",
      "required": ["run_id", "candidate_id", "seed", "generator"],
      "properties": {
        "run_id": { "type": "string" },
        "candidate_id": { "type": "string" },
        "seed": { "type": "integer" },
        "generator": { "type": "string" },
        "generator_version": { "type": "string" },
        "parent_candidate_id": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "status"],
        "properties": {
          "role": {
            "type": "string",
            "examples": ["core_blade", "support_arc", "hit_accent"]
          },
          "status": {
            "type": "string",
            "enum": ["active", "frozen", "disabled", "placeholder"]
          },
          "topology": { "type": "string" },
          "shape_parameters": { "type": "object", "additionalProperties": true },
          "material_parameters": { "type": "object", "additionalProperties": true },
          "timing_parameters": { "type": "object", "additionalProperties": true },
          "constraints": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "render_plan": {
      "type": "object",
      "properties": {
        "unity_project": { "type": "string" },
        "scene": { "type": "string" },
        "camera": { "type": "string" },
        "resolution": { "type": "string" },
        "time_points_seconds": {
          "type": "array",
          "items": { "type": "number" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
