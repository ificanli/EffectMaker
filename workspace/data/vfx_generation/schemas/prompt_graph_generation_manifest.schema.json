{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt_graph_generation_manifest.schema.json",
  "title": "Prompt Graph Generation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "run_id", "prompt_condition", "model", "candidate_count", "candidates", "quality_gates", "status"],
  "properties": {
    "schema_version": { "const": "vfx_prompt_graph_generation_manifest.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 },
    "prompt_condition": { "type": "object" },
    "model": { "type": "object" },
    "candidate_count": { "type": "integer", "minimum": 1 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "graph_id", "profile", "graph_path", "asset_plan_path", "parent_prefab_path", "grammar_valid", "graph_schema_valid", "asset_plan_status", "unity_compile_status", "runtime_visibility_status"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "graph_id": { "type": "string", "pattern": "^pfg_[0-9a-f]{20}$" },
          "profile": { "enum": ["root_only", "particle_v1", "multi_particle"] },
          "graph_path": { "type": "string", "minLength": 1 },
          "asset_plan_path": { "type": "string", "minLength": 1 },
          "vfxspec_path": { "type": ["string", "null"] },
          "parent_prefab_path": { "type": "null" },
          "grammar_valid": { "const": true },
          "graph_schema_valid": { "const": true },
          "asset_plan_status": { "enum": ["pass", "needs_unity_validation", "blocked"] },
          "unity_compile_status": { "enum": ["not_run", "pass", "fail"] },
          "runtime_visibility_status": { "enum": ["not_run", "visible", "near_blank", "fail"] },
          "compile_result_path": { "type": ["string", "null"] },
          "capture_manifest_path": { "type": ["string", "null"] },
          "max_visible_area_ratio": { "type": ["number", "null"] },
          "profile_probability": { "type": ["number", "null"] },
          "training_scope": { "type": ["string", "null"] },
          "seed": { "type": "integer", "minimum": 0 },
          "generator_version": { "type": "string", "minLength": 1 },
          "ai_hypothesis_score": { "type": ["number", "null"] },
          "ai_hypothesis_label_source": { "const": "ai_hypothesis" },
          "in_success_set": { "type": "boolean" }
        }
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_valid_count", "grammar_valid_count", "asset_plan_pass_count", "unity_compile_pass_count", "runtime_visible_count", "technical_success_count", "unique_graph_ids", "human_aesthetic_labels_used"],
      "properties": {
        "schema_valid_count": { "type": "integer", "minimum": 0 },
        "grammar_valid_count": { "type": "integer", "minimum": 0 },
        "asset_plan_pass_count": { "type": "integer", "minimum": 0 },
        "unity_compile_pass_count": { "type": "integer", "minimum": 0 },
        "runtime_visible_count": { "type": "integer", "minimum": 0 },
        "technical_success_count": { "type": "integer", "minimum": 0 },
        "unique_graph_ids": { "type": "boolean" },
        "human_aesthetic_labels_used": { "const": 0 }
      }
    },
    "status": { "enum": ["generated_pending_unity", "pass_technical_prompt_unscored", "blocked"] }
  }
}
