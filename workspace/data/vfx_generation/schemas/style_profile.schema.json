{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "style_profile.schema.json",
  "title": "VFXStyleProfile",
  "type": "object",
  "required": ["schema_version", "family", "keywords", "axes", "scene_context", "source", "confidence"],
  "properties": {
    "schema_version": { "type": "string", "const": "vfx_style_profile.v1" },
    "family": {
      "type": "string",
      "enum": ["unknown", "realistic", "stylized", "cartoon", "anime", "fantasy_painterly", "ui_graphic", "mixed"]
    },
    "keywords": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "axes": {
      "type": "object",
      "required": ["realism", "graphic_stylization", "texture_detail", "color_saturation", "edge_definition", "glow_exaggeration", "motion_exaggeration"],
      "properties": {
        "realism": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "graphic_stylization": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "texture_detail": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "color_saturation": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "edge_definition": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "glow_exaggeration": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "motion_exaggeration": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "scene_context": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "source": {
      "type": "string",
      "enum": ["prompt", "human_annotation", "render_human_review", "rule_inference", "model_inference", "unlabeled_source_import"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
