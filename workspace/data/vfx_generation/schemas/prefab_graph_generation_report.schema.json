{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab_graph_generation_report.schema.json",
  "title": "Generated PrefabGraph Run Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "run_id",
    "decode_path",
    "asset_upgrade_manifest_path",
    "candidate_count",
    "compiled_count",
    "unity_api_readback_pass_count",
    "runtime_capture_count",
    "visual_training_candidate_count",
    "technical_exclusion_count",
    "full_visual_candidate_count",
    "valid_frame_count",
    "candidates",
    "files",
    "quality_gates",
    "limitations",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "vfx_prefab_graph_generation_report.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 },
    "decode_path": { "type": "string", "minLength": 1 },
    "asset_upgrade_manifest_path": { "type": "string", "minLength": 1 },
    "candidate_count": { "type": "integer", "minimum": 1 },
    "compiled_count": { "type": "integer", "minimum": 0 },
    "unity_api_readback_pass_count": { "type": "integer", "minimum": 0 },
    "runtime_capture_count": { "type": "integer", "minimum": 0 },
    "visual_training_candidate_count": { "type": "integer", "minimum": 0 },
    "technical_exclusion_count": { "type": "integer", "minimum": 0 },
    "full_visual_candidate_count": { "type": "integer", "minimum": 0 },
    "valid_frame_count": { "type": "integer", "minimum": 0 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "source_decode_candidate_id",
          "profile",
          "graph_path",
          "asset_plan_path",
          "compile_result_path",
          "readback_result_path",
          "capture_manifest_path",
          "material_timeline_path",
          "compile_status",
          "readback_status",
          "unity_api_readback",
          "parent_prefab_path",
          "generated_texture_count",
          "bound_texture_count",
          "texture_readback_count",
          "texture_binding_readback_match",
          "capture_pipeline_version",
          "frame_count",
          "valid_frame_count",
          "duration_seconds",
          "sample_interval_seconds",
          "max_visible_area_ratio",
          "material_render_error",
          "material_render_error_frame_count",
          "visual_evidence_status",
          "camera_selection_status",
          "context_status",
          "image_sequence_training_eligible",
          "full_visual_training_eligible",
          "eligible_for_visual_training",
          "exclusion_reason",
          "aesthetic_label_source",
          "training_scope"
        ],
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^pfg_[0-9a-f]{20}$" },
          "source_decode_candidate_id": { "type": "string", "pattern": "^pfg_[0-9a-f]{20}$" },
          "profile": { "enum": ["root_only", "particle_v1", "multi_particle"] },
          "graph_path": { "type": "string", "minLength": 1 },
          "asset_plan_path": { "type": "string", "minLength": 1 },
          "compile_result_path": { "type": "string", "minLength": 1 },
          "readback_result_path": { "type": "string", "minLength": 1 },
          "capture_manifest_path": { "type": "string", "minLength": 1 },
          "material_timeline_path": { "type": "string", "minLength": 1 },
          "compile_status": { "type": "string", "minLength": 1 },
          "readback_status": { "type": "string", "minLength": 1 },
          "unity_api_readback": { "type": "boolean" },
          "parent_prefab_path": { "type": "null" },
          "generated_texture_count": { "type": "integer", "minimum": 0 },
          "bound_texture_count": { "type": "integer", "minimum": 0 },
          "texture_readback_count": { "type": "integer", "minimum": 0 },
          "texture_binding_readback_match": { "type": "boolean" },
          "capture_pipeline_version": { "type": "string", "minLength": 1 },
          "frame_count": { "type": "integer", "minimum": 0 },
          "valid_frame_count": { "type": "integer", "minimum": 0 },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "sample_interval_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "max_visible_area_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
          "material_render_error": { "type": "boolean" },
          "material_render_error_frame_count": { "type": "integer", "minimum": 0 },
          "visual_evidence_status": { "type": "string", "minLength": 1 },
          "camera_selection_status": { "type": "string", "minLength": 1 },
          "context_status": { "type": "string", "minLength": 1 },
          "image_sequence_training_eligible": { "type": "boolean" },
          "full_visual_training_eligible": { "type": "boolean" },
          "eligible_for_visual_training": { "type": "boolean" },
          "exclusion_reason": { "type": ["string", "null"] },
          "aesthetic_label_source": { "const": "none" },
          "training_scope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "training_ready", "technical_exclusions"],
      "properties": {
        "records": { "type": "string", "minLength": 1 },
        "training_ready": { "type": "string", "minLength": 1 },
        "technical_exclusions": { "type": "string", "minLength": 1 }
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decode_asset_candidate_alignment",
        "all_parent_prefab_paths_null",
        "all_compile_pass",
        "all_texture_bindings_verified",
        "all_unity_api_readbacks_pass",
        "all_capture_manifests_present",
        "all_capture_pipeline_v2",
        "all_runtime_frames_valid",
        "no_material_render_errors",
        "aesthetic_labels_consumed",
        "visual_training_candidates_present"
      ],
      "properties": {
        "decode_asset_candidate_alignment": { "const": true },
        "all_parent_prefab_paths_null": { "const": true },
        "all_compile_pass": { "const": true },
        "all_texture_bindings_verified": { "const": true },
        "all_unity_api_readbacks_pass": { "const": true },
        "all_capture_manifests_present": { "const": true },
        "all_capture_pipeline_v2": { "const": true },
        "all_runtime_frames_valid": { "const": true },
        "no_material_render_errors": { "const": true },
        "aesthetic_labels_consumed": { "const": false },
        "visual_training_candidates_present": { "const": true }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "status": { "const": "pass" }
  }
}
