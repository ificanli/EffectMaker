{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab_asset_plan.schema.json",
  "title": "Prefab Asset Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "candidate_id", "parent_prefab_path", "assets", "selection_basis", "training_scope", "status"],
  "properties": {
    "schema_version": { "const": "vfx_prefab_asset_plan.v1" },
    "plan_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "pattern": "^pfg_[0-9a-f]{20}$" },
    "parent_prefab_path": { "type": "null" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_role", "selection_mode", "path", "shader_name", "authorization_status", "selection_basis"],
        "properties": {
          "asset_role": { "enum": ["material_template", "generated_texture"] },
          "selection_mode": { "enum": ["audited_local_template", "deterministic_generated"] },
          "path": { "type": ["string", "null"] },
          "shader_name": { "type": ["string", "null"] },
          "texture_profile": { "type": ["string", "null"] },
          "asset_id": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"] },
          "authorization_status": { "enum": ["confirmed", "local_source_unconfirmed", "generated"] },
          "selection_basis": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "selection_basis": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "training_scope": { "const": "technical_asset_routing; no aesthetic or human preference supervision" },
    "status": { "const": "pass" }
  }
}
