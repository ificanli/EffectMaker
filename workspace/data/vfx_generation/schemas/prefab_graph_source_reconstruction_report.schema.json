{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab_graph_source_reconstruction_report.schema.json",
  "title": "Source PrefabGraph Reconstruction Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "source_export_manifest", "recompile_results_dir", "readback_results_dir", "candidate_count", "rows", "quality_gates", "status", "limitations"],
  "properties": {
    "schema_version": { "const": "vfx_prefab_graph_source_reconstruction_report.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_export_manifest": { "type": "string", "minLength": 1 },
    "recompile_results_dir": { "type": "string", "minLength": 1 },
    "readback_results_dir": { "type": "string", "minLength": 1 },
    "candidate_count": { "type": "integer", "minimum": 1 },
    "rows": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "quality_gates": { "type": "object" },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "const": "pass" }
  }
}
