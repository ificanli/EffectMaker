{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt_graph_dual_family_report.schema.json",
  "title": "Prompt Graph Dual Family Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "family_count", "families", "human_aesthetic_labels_used", "limitations", "status"],
  "properties": {
    "schema_version": { "const": "vfx_prompt_graph_dual_family_report.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "family_count": { "const": 2 },
    "families": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object" } },
    "human_aesthetic_labels_used": { "const": 0 },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "status": { "const": "pass_technical_prompt_unscored" }
  }
}
