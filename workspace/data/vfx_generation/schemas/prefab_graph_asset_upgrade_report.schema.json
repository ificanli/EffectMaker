{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab_graph_asset_upgrade_report.schema.json",
  "title": "PrefabGraph Asset Upgrade Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "upgrade_manifest", "capture_root", "candidate_count", "compile_status_counts", "rows", "quality_gates", "training_scope", "status"],
  "properties": {
    "schema_version": { "const": "vfx_prefab_graph_asset_upgrade_report.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "upgrade_manifest": { "type": "string", "minLength": 1 },
    "capture_root": { "type": "string", "minLength": 1 },
    "candidate_count": { "type": "integer", "minimum": 1 },
    "compile_status_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "rows": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "quality_gates": { "type": "object" },
    "training_scope": { "type": "string", "minLength": 1 },
    "status": { "const": "pass" }
  }
}
