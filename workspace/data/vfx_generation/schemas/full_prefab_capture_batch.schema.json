{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full_prefab_capture_batch.schema.json",
  "title": "Full Prefab Incremental Capture Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "batch_id", "source_baseline", "eligible_count", "selected_count", "excluded_previous_count", "source_group_counts", "effect_family_counts", "technical_status_counts", "selected", "request_path", "selection_policy", "quality_gates", "status"],
  "properties": {
    "schema_version": { "const": "vfx_full_prefab_capture_batch.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "batch_id": { "type": "string", "minLength": 1 },
    "source_baseline": { "type": "string", "minLength": 1 },
    "eligible_count": { "type": "integer", "minimum": 0 },
    "selected_count": { "type": "integer", "minimum": 1 },
    "excluded_previous_count": { "type": "integer", "minimum": 0 },
    "source_group_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "effect_family_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "technical_status_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "selected": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "request_path": { "type": "string", "minLength": 1 },
    "selection_policy": { "enum": ["deterministic_source_family_complexity_round_robin.v1", "explicit_prefab_paths.v1"] },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duplicate_prefabs", "non_playable_selected", "missing_prefab_files", "generated_prefabs_selected"],
      "properties": {
        "duplicate_prefabs": { "const": 0 },
        "non_playable_selected": { "const": 0 },
        "missing_prefab_files": { "const": 0 },
        "generated_prefabs_selected": { "const": 0 }
      }
    },
    "status": { "const": "pass" }
  }
}
