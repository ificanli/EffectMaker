{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vfx_prompt_condition_v2.schema.json",
  "title": "VFX Prompt Condition v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "text",
    "style_family",
    "color_keywords",
    "effect_element_tags",
    "effect_type",
    "target_effect_family",
    "effect_families",
    "source_categories",
    "motion_keywords",
    "timing_profile",
    "negative_constraints",
    "candidate_count",
    "seed",
    "performance_tier"
  ],
  "properties": {
    "schema_version": { "const": "vfx_prompt_condition.v2" },
    "prompt_id": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "style_family": { "enum": ["unknown", "realistic", "stylized", "cartoon", "anime", "fantasy_painterly", "ui_graphic", "mixed"] },
    "color_keywords": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "effect_element_tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "effect_type": { "type": "string", "enum": ["impact", "explosion", "slash", "magic_circle", "laser", "lightning", "fire", "shield", "smoke", "water"] },
    "target_effect_family": { "type": "string", "minLength": 1 },
    "effect_families": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "source_categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["battle", "character", "ui", "scene", "enemy", "unclassified"] } },
    "motion_keywords": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "timing_profile": { "enum": ["fast_impact", "short", "medium", "long", "loop", "unknown"] },
    "negative_constraints": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "candidate_count": { "type": "integer", "minimum": 4, "maximum": 8 },
    "seed": { "type": "integer", "minimum": 0 },
    "performance_tier": { "enum": ["mobile", "standard"] }
  }
}
