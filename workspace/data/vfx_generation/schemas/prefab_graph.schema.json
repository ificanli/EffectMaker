{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab_graph.schema.json",
  "title": "VFX PrefabGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "source",
    "root_node_id",
    "nodes",
    "components",
    "asset_bindings",
    "reconstruction",
    "training",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "vfx_prefab_graph.v1" },
    "graph_id": { "type": "string", "pattern": "^pfg_[0-9a-f]{20}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "prefab_path", "source_example_id"],
      "properties": {
        "source_kind": { "enum": ["unity_audit", "generated"] },
        "prefab_path": { "type": ["string", "null"] },
        "source_example_id": { "type": ["string", "null"] }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "effect_family", "style_family", "seed", "parent_prefab_path"],
      "properties": {
        "prompt": { "type": ["string", "null"] },
        "effect_family": { "type": ["string", "null"] },
        "style_family": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] },
        "parent_prefab_path": { "type": "null" }
      }
    },
    "root_node_id": { "$ref": "#/$defs/nodeId" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["particle_systems", "renderers", "animations"],
      "properties": {
        "particle_systems": {
          "type": "array",
          "items": { "$ref": "#/$defs/particleSystem" }
        },
        "renderers": {
          "type": "array",
          "items": { "$ref": "#/$defs/renderer" }
        },
        "animations": {
          "type": "array",
          "items": { "$ref": "#/$defs/animation" }
        }
      }
    },
    "asset_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materials", "meshes"],
      "properties": {
        "materials": { "$ref": "#/$defs/uniquePaths" },
        "meshes": { "$ref": "#/$defs/uniquePaths" }
      }
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "compiler_profile", "missing_fields", "unsupported_components"],
      "properties": {
        "status": { "enum": ["structure_only", "reconstructable"] },
        "compiler_profile": { "enum": ["none", "particle_v1"] },
        "missing_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unsupported_components": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_tasks", "excluded_tasks", "aesthetic_label_source"],
      "properties": {
        "eligible_tasks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["hierarchy_modeling", "component_prediction", "particle_parameter_modeling", "full_reconstruction"] }
        },
        "excluded_tasks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["aesthetic_preference", "prompt_condition", "full_reconstruction"] }
        },
        "aesthetic_label_source": { "enum": ["none", "ai_hypothesis", "human"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_dataset_id", "source_run_id", "exporter", "assumptions"],
      "properties": {
        "source_dataset_id": { "type": "string", "minLength": 1 },
        "source_run_id": { "type": ["string", "null"] },
        "exporter": { "enum": ["prefab_graph.v1", "prefab_graph_readback.v1", "prefab_graph_constrained.v1", "prefab_graph_source_unity.v1"] },
        "assumptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "particleColorGradient": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "color_keys", "alpha_keys"],
      "properties": {
        "mode": {"enum": ["Blend", "Fixed"]},
        "color_keys": {
          "type": "array", "minItems": 2, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["time", "rgb"],
            "properties": {
              "time": {"type": "number", "minimum": 0, "maximum": 1},
              "rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}}
            }
          }
        },
        "alpha_keys": {
          "type": "array", "minItems": 2, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["time", "alpha"],
            "properties": {
              "time": {"type": "number", "minimum": 0, "maximum": 1},
              "alpha": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "nodeId": { "type": "string", "pattern": "^n[0-9]{4}$" },
    "componentId": { "type": "string", "pattern": "^[pra][0-9]{4}$" },
    "vector3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false
    },
    "quaternion": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_position", "local_rotation", "local_scale"],
      "properties": {
        "local_position": { "oneOf": [{ "$ref": "#/$defs/vector3" }, { "type": "null" }] },
        "local_rotation": { "oneOf": [{ "$ref": "#/$defs/quaternion" }, { "type": "null" }] },
        "local_scale": { "oneOf": [{ "$ref": "#/$defs/vector3" }, { "type": "null" }] }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "name", "sibling_index", "depth", "parent_node_id", "hierarchy_path", "active_self", "component_types", "transform"],
      "properties": {
        "node_id": { "$ref": "#/$defs/nodeId" },
        "name": { "type": "string", "minLength": 1 },
        "sibling_index": { "type": "integer", "minimum": 0 },
        "depth": { "type": "integer", "minimum": 0 },
        "parent_node_id": { "oneOf": [{ "$ref": "#/$defs/nodeId" }, { "type": "null" }, { "const": "" }] },
        "hierarchy_path": { "type": "string", "minLength": 1 },
        "active_self": { "type": "boolean" },
        "component_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "transform": { "$ref": "#/$defs/transform" }
        ,
        "role": { "enum": ["root", "core", "support", "hit", "residual", "unclassified"] }
      }
    },
    "particleSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "node_id", "parameters", "material_paths", "mesh_paths"],
      "properties": {
        "component_id": { "$ref": "#/$defs/componentId" },
        "node_id": { "$ref": "#/$defs/nodeId" },
        "parameters": {
          "type": "object",
          "properties": {
            "color_over_lifetime_gradient": {"oneOf": [{"$ref": "#/$defs/particleColorGradient"}, {"type": "null"}]},
            "material_color_mode": {"enum": [null, "legacy_start_color", "preserve_template"]}
          }
        },
        "material_paths": { "$ref": "#/$defs/uniquePaths" },
        "mesh_paths": { "$ref": "#/$defs/uniquePaths" }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "node_id", "renderer_type", "enabled", "parameters", "material_paths", "mesh_paths"],
      "properties": {
        "component_id": { "$ref": "#/$defs/componentId" },
        "node_id": { "$ref": "#/$defs/nodeId" },
        "renderer_type": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "parameters": { "type": "object" },
        "material_paths": { "$ref": "#/$defs/uniquePaths" },
        "mesh_paths": { "$ref": "#/$defs/uniquePaths" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "node_id", "animation_type", "parameters"],
      "properties": {
        "component_id": { "$ref": "#/$defs/componentId" },
        "node_id": { "$ref": "#/$defs/nodeId" },
        "animation_type": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" }
      }
    },
    "uniquePaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
